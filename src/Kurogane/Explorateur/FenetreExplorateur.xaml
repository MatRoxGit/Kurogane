<!--
  KUROGANE // explorateur — coquille

  Étape 1 : l'apparence seule, contenu figé. Rien ne navigue, rien ne lit le
  disque. On valide la fenêtre avant d'investir dans le comportement, comme
  on l'a fait pour la barre.

  WindowChrome plutôt qu'AllowsTransparency : on garde le redimensionnement
  natif et l'accélération matérielle, et on ne paie pas le rendu logiciel
  qu'impose une fenêtre transparente.
-->
<Window x:Class="Kurogane.Explorateur.FenetreExplorateur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:Kurogane.Barre"
        xmlns:k="clr-namespace:Kurogane.Explorateur"
        Title="KRG//EXPLORER" Width="1040" Height="660"
        MinWidth="720" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Obsidienne}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Bouton de fenêtre : plat, sans cadre. La fermeture vire au
                 rouge au survol, les deux autres à la soudure. -->
            <Style x:Key="BoutonFenetre" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TexteEteint}" />
                <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fond" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fond" Property="Background"
                                            Value="{DynamicResource Soudure}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TexteVif}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BoutonFermer" TargetType="Button" BasedOn="{StaticResource BoutonFenetre}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fond" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fond" Property="Background"
                                            Value="{DynamicResource Rouge}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bouton de navigation : carré, cadre discret. -->
            <Style x:Key="BoutonNav" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Foreground" Value="{DynamicResource TexteVif}" />
                <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fond" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Soudure}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fond" Property="BorderBrush"
                                            Value="{DynamicResource Rouge}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Nœud du volet gauche. Le liseré rouge marque la sélection. -->
            <Style x:Key="Noeud" TargetType="ContentControl">
                <Setter Property="Height" Value="38" />
                <Setter Property="Margin" Value="8,1" />
                <Setter Property="Foreground" Value="{DynamicResource TexteEteint}" />
                <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border x:Name="Fond" Background="Transparent"
                                    Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fond" Property="Background"
                                            Value="{DynamicResource Surface}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoeudActif" TargetType="ContentControl" BasedOn="{StaticResource Noeud}">
                <Setter Property="Foreground" Value="{DynamicResource TexteVif}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Rouge}"
                                    BorderThickness="2,0,0,0" Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Separateur" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Rouge}" />
                <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Text" Value="//" />
            </Style>

            <Style x:Key="Segment" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TexteVif}" />
                <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Etiquette" TargetType="TextBlock" BasedOn="{StaticResource Segment}">
                <Setter Property="Foreground" Value="{DynamicResource TexteEteint}" />
                <Setter Property="FontSize" Value="10" />
            </Style>

            <!-- La carte est le gabarit du CONTENEUR, pas de la donnée.
                 Un DataTemplate ne voit pas l'état de sélection : il est
                 porté par le ListBoxItem qui l'entoure. En mettant la carte
                 dans son template, les déclencheurs y accèdent directement. -->
            <!-- Gabarit propre au champ de saisie. Sous un thème de
                 contraste, WPF bascule sur ses gabarits d'accessibilité, qui
                 redessinent une bordure à partir de WindowText — blanche
                 ici — en ignorant BorderThickness. Définir le gabarit
                 soustrait le champ à ce mécanisme. -->
            <Style x:Key="ChampNu" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TexteVif}" />
                <Setter Property="CaretBrush" Value="{DynamicResource Rouge}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Rouge}" />
                <Setter Property="SelectionOpacity" Value="0.4" />
                <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bouton de tri. RadioButton pour l'exclusivité mutuelle,
                 mais entièrement regabarité : le rond système reviendrait
                 habillé par le thème de contraste, comme tout le reste. -->
            <Style x:Key="BoutonTri" TargetType="RadioButton">
                <Setter Property="Margin" Value="0,0,18,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Background="Transparent">
                                <TextBlock x:Name="Libelle"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource TexteEteint}"
                                           FontFamily="{DynamicResource Mono}"
                                           FontSize="10" />
                                <Rectangle x:Name="Trait" Height="1.5" Margin="0,3,0,0"
                                           Fill="Transparent" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Libelle" Property="Foreground"
                                            Value="{DynamicResource TexteVif}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Libelle" Property="Foreground"
                                            Value="{DynamicResource TexteVif}" />
                                    <Setter TargetName="Trait" Property="Fill"
                                            Value="{DynamicResource Rouge}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Separation" TargetType="GridSplitter">
                <Setter Property="Width" Value="5" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border x:Name="Rail" Background="Transparent">
                                <Rectangle x:Name="Trait" Width="1"
                                           HorizontalAlignment="Center"
                                           Fill="{DynamicResource Soudure}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Trait" Property="Fill"
                                            Value="{DynamicResource Rouge}" />
                                    <Setter TargetName="Trait" Property="Width" Value="2" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Trait" Property="Fill"
                                            Value="{DynamicResource Rouge}" />
                                    <Setter TargetName="Trait" Property="Width" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Barre de défilement. Troisième contrôle standard à devoir
                 son gabarit : sous un thème de contraste, celui de WPF la
                 dessine en WindowText, soit presque blanc ici. Styles
                 implicites, pour qu'elle vaille partout dans la fenêtre. -->
            <Style x:Key="PisteBarre" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PouceBarre" TargetType="Thumb">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Corps" Margin="2,0"
                                    Background="{DynamicResource Soudure}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Corps" Property="Background"
                                            Value="{DynamicResource RougeEteint}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Corps" Property="Background"
                                            Value="{DynamicResource Rouge}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="11" />
                <Setter Property="MinWidth" Value="11" />
                <Setter Property="Background" Value="{DynamicResource Creux}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Soudure}"
                                    BorderThickness="1,0,0,0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PisteBarre}"
                                                      Command="ScrollBar.PageUpCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PouceBarre}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PisteBarre}"
                                                      Command="ScrollBar.PageDownCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Poignée de dépliage : un chevron, pas le triangle système,
                 qui serait redessiné par le thème de contraste. -->
            <Style x:Key="Poignee" TargetType="ToggleButton">
                <Setter Property="Width" Value="16" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Chevron" Text="›"
                                           Foreground="{DynamicResource TexteEteint}"
                                           FontFamily="{DynamicResource Mono}"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Text" Value="⌄" />
                                    <Setter TargetName="Chevron" Property="Foreground"
                                            Value="{DynamicResource Rouge}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chevron" Property="Foreground"
                                            Value="{DynamicResource Rouge}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoeudArbreItem" TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TexteEteint}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="Ligne" Height="32"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="2,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton x:Name="Expander" Grid.Column="0"
                                                      Style="{StaticResource Poignee}"
                                                      ClickMode="Press"
                                                      IsChecked="{Binding IsExpanded,
                                                          RelativeSource={RelativeSource TemplatedParent}}" />

                                        <ContentPresenter Grid.Column="1"
                                                          ContentSource="Header"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ItemsPresenter x:Name="Branches" Margin="14,0,0,0" />
                            </StackPanel>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="Branches" Property="Visibility"
                                            Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Expander" Property="Visibility"
                                            Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ligne" Property="Background"
                                            Value="{DynamicResource Surface}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Ligne" Property="Background"
                                            Value="{DynamicResource Surface}" />
                                    <Setter TargetName="Ligne" Property="BorderBrush"
                                            Value="{DynamicResource Rouge}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TexteVif}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <HierarchicalDataTemplate DataType="{x:Type k:NoeudArbre}"
                                      ItemsSource="{Binding Enfants}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Border Width="20" Height="20" Margin="0,0,9,0"
                            VerticalAlignment="Center">
                        <Image Source="{Binding Icone}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{Binding Libelle}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Mono}" FontSize="11" />
                    <TextBlock Text=" // " VerticalAlignment="Center"
                               Foreground="{DynamicResource RougeEteint}"
                               FontFamily="{DynamicResource Mono}" FontSize="11" />
                    <TextBlock Text="{Binding Detail}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Mono}" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="130" />
                </StackPanel>
            </HierarchicalDataTemplate>

            <Style x:Key="CarteItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <b:Biseau x:Name="Coque" Coupe="8"
                                      Width="236" Height="62"
                                      Margin="0,0,10,10" Padding="12,0"
                                      Cursor="Hand"
                                      Background="{DynamicResource Surface}"
                                      BorderBrush="{DynamicResource Soudure}"
                                      BorderThickness="1"
                                      ToolTip="{Binding Chemin}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border x:Name="Vignette" Width="34" Height="34"
                                            Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="{DynamicResource Creux}"
                                            BorderBrush="{DynamicResource RougeEteint}"
                                            BorderThickness="1">
                                        <Image Source="{Binding Icone}" Width="24" Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nom}" MaxWidth="150"
                                                   Foreground="{DynamicResource TexteVif}"
                                                   FontFamily="{DynamicResource Mono}"
                                                   FontSize="11" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Meta}"
                                                       Foreground="{DynamicResource TexteEteint}"
                                                       FontFamily="{DynamicResource Mono}"
                                                       FontSize="9.5" />
                                            <TextBlock Text=" // "
                                                       Foreground="{DynamicResource Rouge}"
                                                       FontFamily="{DynamicResource Mono}"
                                                       FontSize="9.5" />
                                            <TextBlock Text="{Binding Date}"
                                                       Foreground="{DynamicResource TexteEteint}"
                                                       FontFamily="{DynamicResource Mono}"
                                                       FontSize="9.5" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </b:Biseau>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Coque" Property="BorderBrush"
                                            Value="{DynamicResource RougeEteint}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Coque" Property="BorderBrush"
                                            Value="{DynamicResource Rouge}" />
                                    <Setter TargetName="Coque" Property="BorderThickness"
                                            Value="1.5" />
                                    <Setter TargetName="Coque" Property="Background"
                                            Value="{DynamicResource Soudure}" />
                                    <Setter TargetName="Vignette" Property="BorderBrush"
                                            Value="{DynamicResource Rouge}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Rouge}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="38" />
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ===== Rail ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource Rail}">
                <Rectangle x:Name="Encoche" Fill="{DynamicResource Rouge}"
                           HorizontalAlignment="Left" Width="300" />
            </Grid>

            <!-- ===== Barre de titre ===== -->
            <Grid Grid.Row="1" Background="{DynamicResource Surface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <b:Biseau Grid.Column="0" Coupe="5" Width="26" Height="24"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          Background="{DynamicResource Creux}"
                          BorderBrush="{DynamicResource Rouge}" BorderThickness="1">
                    <TextBlock Text="▣" Foreground="{DynamicResource Rouge}"
                               FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </b:Biseau>

                <TextBlock Grid.Column="1" Text="KRG//EXPLORER" Margin="10,0,0,0"
                           Foreground="{DynamicResource TexteVif}"
                           FontFamily="{DynamicResource Mono}" FontSize="12"
                           FontWeight="Bold" VerticalAlignment="Center" />

                <Border Grid.Column="2" Margin="14,0,0,0" Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Creux}"
                        BorderBrush="{DynamicResource RougeEteint}" BorderThickness="1">
                    <TextBlock x:Name="Puce" Text="PID:0000 // RING-3"
                               Foreground="{DynamicResource Rouge}"
                               FontFamily="{DynamicResource Mono}" FontSize="9.5"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="30" Height="1" Fill="{DynamicResource Soudure}" Margin="3,0" />
                    <Rectangle Width="6"  Height="1" Fill="{DynamicResource RougeEteint}" Margin="3,0" />
                    <Rectangle Width="6"  Height="1" Fill="{DynamicResource RougeEteint}" Margin="3,0" />
                    <Rectangle Width="30" Height="1" Fill="{DynamicResource Soudure}" Margin="3,0" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="BtnReduire"  Style="{StaticResource BoutonFenetre}" Content="—" />
                    <Button x:Name="BtnAgrandir" Style="{StaticResource BoutonFenetre}" Content="▢" />
                    <Button x:Name="BtnFermer"   Style="{StaticResource BoutonFermer}"  Content="✕" />
                </StackPanel>
            </Grid>

            <!-- ===== Barre d'outils ===== -->
            <Grid Grid.Row="2" Background="{DynamicResource Obsidienne}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Margin="12,0,6,0" VerticalAlignment="Center">
                    <Button x:Name="BtnPrecedent" Style="{StaticResource BoutonNav}" Content="‹" />
                    <Button x:Name="BtnSuivant"   Style="{StaticResource BoutonNav}" Content="›" />
                    <Button x:Name="BtnParent"    Style="{StaticResource BoutonNav}" Content="↑" />
                </StackPanel>

                <Border Grid.Column="1" Height="28" VerticalAlignment="Center"
                        Background="{DynamicResource Creux}"
                        BorderBrush="{DynamicResource Soudure}" BorderThickness="1"
                        Padding="10,0">
                    <StackPanel x:Name="FilDAriane" Orientation="Horizontal"
                                VerticalAlignment="Center" />
                </Border>

                <!-- La boîte entière EST le champ. L'étiquette « FILTRER »
                     en tête se lisait comme un libellé et laissait croire
                     que la saisie se faisait ailleurs : elle devient
                     l'invite, à l'intérieur, et disparaît à la frappe. -->
                <Border x:Name="BoiteFiltre" Grid.Column="2" Height="28"
                        Margin="10,0,12,0" VerticalAlignment="Center"
                        BorderThickness="1" Padding="10,0" Cursor="IBeam">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="Loupe" Grid.Column="0" Text="⌕"
                                   Foreground="{DynamicResource TexteEteint}"
                                   FontSize="13" Margin="0,0,9,0"
                                   VerticalAlignment="Center" />

                        <Grid Grid.Column="1">
                            <TextBlock x:Name="Invite" IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Mono}" FontSize="11">
                                <Run Text="FILTRER" Foreground="#FF8C6268" />
                                <Run Text=" // " Foreground="#FF3A1016" />
                                <Run Text="NOM OU *.EXT" Foreground="#FF8C6268" />
                            </TextBlock>

                            <TextBox x:Name="Filtre" Style="{StaticResource ChampNu}"
                                     HorizontalAlignment="Stretch" />
                        </Grid>
                    </Grid>

                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- En Setter et non en attribut : une valeur
                                 posée localement sur l'élément l'emporte sur
                                 un déclencheur, et le liseré au focus ne
                                 s'afficherait jamais. -->
                            <Setter Property="Background" Value="{DynamicResource Creux}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Soudure}" />
                            <Style.Triggers>
                                <!-- Le liseré rouge au focus : le seul signal
                                     qui dise sans ambiguïté où va la frappe. -->
                                <DataTrigger Value="True"
                                             Binding="{Binding IsKeyboardFocusWithin,
                                                       RelativeSource={RelativeSource Self}}">
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource RougeEteint}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <!-- ===== Corps ===== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <!-- MinWidth des deux côtés : sans elles, la poignée
                         laisse réduire un volet à zéro et il devient
                         impossible de le rattraper à la souris. -->
                    <ColumnDefinition x:Name="ColonneVolet" Width="248"
                                      MinWidth="170" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Volet des nœuds -->
                <Border Grid.Column="0" Background="{DynamicResource Obsidienne}"
                        BorderBrush="{DynamicResource Soudure}" BorderThickness="0,0,1,0">
                    <!-- Grid et non StackPanel : un ScrollViewer empilé
                         reçoit une hauteur infinie et ne défile jamais. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="18,16,0,10"
                                   Style="{StaticResource Etiquette}">
                            <Run Text="NOEUDS SYSTÈME" />
                            <Run Text=" // " Foreground="{DynamicResource Rouge}" />
                            <Run Text="MONTÉS" />
                        </TextBlock>

                        <TreeView x:Name="Arbre" Grid.Row="1"
                                  Background="Transparent" BorderThickness="0"
                                  Padding="6,0,0,8"
                                  ItemContainerStyle="{StaticResource NoeudArbreItem}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Style="{StaticResource Separation}" />

                <!-- Contenu -->
                <Grid Grid.Column="2" Background="{DynamicResource Obsidienne}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="14,16,14,10" Height="30"
                            Background="{DynamicResource Creux}"
                            BorderBrush="{DynamicResource Soudure}" BorderThickness="1"
                            Padding="12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Etiquette}" Text="TRIER"
                                           Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Separateur}"
                                           Margin="6,0,14,4" />
                                <RadioButton x:Name="TriNom"    Style="{StaticResource BoutonTri}"
                                             Content="NOM" IsChecked="True" />
                                <RadioButton x:Name="TriTaille" Style="{StaticResource BoutonTri}"
                                             Content="TAILLE" />
                                <RadioButton x:Name="TriDate"   Style="{StaticResource BoutonTri}"
                                             Content="DATE" />
                                <RadioButton x:Name="TriType"   Style="{StaticResource BoutonTri}"
                                             Content="TYPE" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="Ordre" Style="{StaticResource Etiquette}"
                                           Text="A → Z" Margin="0,0,12,0" />
                                <Button x:Name="BtnSens" Style="{StaticResource BoutonNav}"
                                        Width="26" Height="22" Margin="0"
                                        Content="▲" FontSize="9"
                                        ToolTip="Inverser le sens du tri" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="Cartes" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TexteVif}"
                             SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource CarteItem}"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.CanContentScroll="True"
                             KeyboardNavigation.DirectionalNavigation="Contained">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <k:PanneauCartes LargeurCarte="246" HauteurCarte="72" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="14,0,14,14"
                                              Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ===== Barre d'état ===== -->
            <Grid Grid.Row="4" Background="{DynamicResource Surface}">
                <StackPanel Orientation="Horizontal" Margin="14,0"
                            VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Rouge}"
                             Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Compte" Style="{StaticResource Etiquette}"
                               Foreground="{DynamicResource TexteVif}" Text="0 OBJETS CHARGÉS" />
                    <TextBlock Style="{StaticResource Separateur}" FontSize="10" />
                    <TextBlock x:Name="Erreurs" Style="{StaticResource Etiquette}" Text="0 ERREUR" />
                    <Rectangle Width="1" Height="12" Fill="{DynamicResource Soudure}"
                               Margin="14,0" />
                    <TextBlock x:Name="Detail" Style="{StaticResource Etiquette}"
                               Text="—" />
                    <Rectangle Width="1" Height="12" Fill="{DynamicResource Soudure}"
                               Margin="14,0" />
                    <TextBlock x:Name="Chrono" Style="{StaticResource Etiquette}"
                               Text="—" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="14,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Etiquette}" Text="DWM" />
                    <TextBlock Style="{StaticResource Separateur}" FontSize="10" />
                    <TextBlock Style="{StaticResource Etiquette}" Text="SYNC"
                               Foreground="{DynamicResource Ambre}" />
                    <TextBlock Text="↗" Foreground="{DynamicResource Ambre}"
                               FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
