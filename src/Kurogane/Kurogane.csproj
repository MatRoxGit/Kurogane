<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Kurogane</RootNamespace>
    <AssemblyName>kurogane</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- WPF pour la barre des tâches Kurogane. Fourni par le SDK Windows
         Desktop : aucun paquet NuGet n'est ajouté pour autant. -->
    <UseWPF>true</UseWPF>
    <!-- WPF a besoin des données de globalisation ICU : son cache de
         polices associe des langues à des polices et construit pour cela
         des CultureInfo spécifiques. Avec InvariantGlobalization, cette
         construction lève, et l'initialiseur de MS.Internal.FontCache
         .MajorLanguages échoue — sans aucun rapport avec le fichier unique.
         Le réglage avait été mis pour alléger la publication ; il est
         incompatible avec WPF. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Les bibliothèques natives de WPF sont embarquées dans l'exe, pour
         qu'un fichier unique en soit réellement un. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Pas de manifeste : l'outil tourne en asInvoker (aucun droit admin requis
         pour le niveau 1). Le niveau 2 (Shell Icons, HKLM) viendra avec son
         propre chemin d'élévation explicite. -->
  </PropertyGroup>

</Project>
