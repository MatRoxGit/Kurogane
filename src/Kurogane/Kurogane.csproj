<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Kurogane</RootNamespace>
    <AssemblyName>kurogane</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Pas de manifeste : l'outil tourne en asInvoker (aucun droit admin requis
         pour le niveau 1). Le niveau 2 (Shell Icons, HKLM) viendra avec son
         propre chemin d'élévation explicite. -->
  </PropertyGroup>

</Project>
