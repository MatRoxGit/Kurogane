<!--
  KUROGANE // barre des tâches

  Angles vifs, traits nets, aucun arrondi : le vocabulaire est industriel,
  pas celui de Windows 11. Chaque élément est un cadre, pas une pastille.
-->
<Window x:Class="Kurogane.Barre.FenetreBarre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurogane"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Obsidienne}">

    <Window.Resources>
        <SolidColorBrush x:Key="Obsidienne"   Color="#FF0B0708" />
        <SolidColorBrush x:Key="Surface"      Color="#FF120A0C" />
        <SolidColorBrush x:Key="Rouge"        Color="#FFC8102E" />
        <SolidColorBrush x:Key="RougeVoile"   Color="#38C8102E" />
        <SolidColorBrush x:Key="TexteVif"     Color="#FFF4F0F1" />
        <SolidColorBrush x:Key="TexteEteint"  Color="#FF8C6268" />
        <FontFamily x:Key="Mono">JetBrains Mono, Consolas, Courier New</FontFamily>

        <!-- Bouton : cadre rouge, fond sombre, aucun arrondi. -->
        <Style x:Key="Cellule" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rouge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TexteVif}" />
            <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background"
                                        Value="{DynamicResource RougeVoile}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Le seul trait épais du dessin : la ligne rouge en haut de la barre. -->
    <Border BorderBrush="{DynamicResource Rouge}" BorderThickness="0,2,0,0">
        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Emblème et recherche -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BoutonDemarrer" Style="{StaticResource Cellule}"
                        Width="44" Height="38" Padding="0"
                        ToolTip="Menu Démarrer">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="64" Height="64">
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="44" Height="44"
                                     Stroke="{DynamicResource Rouge}" StrokeThickness="2.4" />
                            <Path Fill="{DynamicResource Rouge}"
                                  Data="M 19,18 L 24,18 L 24,25.5 L 19,31 Z M 19,33 L 24,38.5 L 24,46 L 19,46 Z M 21,32 L 32.5,18 L 38,18 L 26.5,32 L 38,46 L 32.5,46 Z M 29.5,32 L 41,18 L 46.5,18 L 35,32 L 46.5,46 L 41,46 Z" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="BoutonRecherche" Style="{StaticResource Cellule}"
                        Width="220" Height="34" Margin="8,0,0,0"
                        HorizontalContentAlignment="Left" ToolTip="Rechercher">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Stroke="{DynamicResource TexteEteint}" StrokeThickness="1.4"
                                  Data="M 1,1 L 8,1 L 8,8 L 1,8 Z M 8,8 L 11,11" />
                        </Canvas>
                        <TextBlock Text="EXEC // RECHERCHE..."
                                   Foreground="{DynamicResource TexteEteint}"
                                   FontFamily="{DynamicResource Mono}" FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bloc d'état -->
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="10,3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Rouge}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="Noeud" Text="SYS.NODE // 01"
                               Foreground="{DynamicResource TexteEteint}"
                               FontFamily="{DynamicResource Mono}" FontSize="9" />
                    <TextBlock x:Name="Etat" Text="SEC.ONLINE"
                               Foreground="{DynamicResource Rouge}" FontWeight="Bold"
                               FontFamily="{DynamicResource Mono}" FontSize="10" />
                </StackPanel>
            </Border>

            <!-- Applications épinglées, remplies depuis le thème -->
            <StackPanel x:Name="Epingles" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Horloge -->
            <Border Grid.Column="3" Padding="10,3" VerticalAlignment="Center"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Rouge}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="Heure" Text="00:00:00"
                               Foreground="{DynamicResource TexteVif}" FontWeight="Bold"
                               FontFamily="{DynamicResource Mono}" FontSize="11"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateDuJour" Text="0000.00.00"
                               Foreground="{DynamicResource Rouge}"
                               FontFamily="{DynamicResource Mono}" FontSize="9"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
