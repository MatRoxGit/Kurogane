{
  "name": "Kurogane Obsidian",
  "version": "0.6.0",
  "author": "Mathieu",
  "darkMode": {
    "apps": true,
    "system": true
  },
  "accent": {
    "color": "#C8102E",
    "titleBars": true,
    "taskbarAndStart": true,
    "transparency": false
  },
  "wallpaper": {
    "path": "../assets/wallpapers/Wallpaper_Kurogane.jpg",
    "style": "fill"
  },
  "taskbar": {
    "alignment": "left",
    "size": "small",
    "search": "icon",
    "chat": false,
    "taskView": true,
    "combineButtons": "always",
    "secondsInClock": true,
    "animations": true,
    "autoHide": false
  },
  "startMenu": {
    "layout": "morePins",
    "recentFiles": false,
    "recentApps": false,
    "accountNotifications": false
  },
  "taskbarStyle": {
    "marge": 12,
    "margeBasse": 6,
    "rayon": 10,
    "teinte": "#C8102E",
    "opacite": 180,
    "acrylique": true
  },
  "barre": {
    "noeud": "SYS.NODE // 01",
    "etat": "SEC.ONLINE",
    "suffixeDate": "KRG",
    "epingles": [
      {
        "libelle": "EXPLORATEUR",
        "commande": "explorer.exe",
        "icone": "dossier.ico"
      },
      {
        "libelle": "TERMINAL",
        "commande": "powershell.exe",
        "icone": "terminal.ico"
      },
      {
        "libelle": "CODE",
        "commande": "code",
        "icone": "code.ico"
      },
      {
        "libelle": "PARAMETRES",
        "commande": "ms-settings:",
        "icone": "panneau-configuration.ico"
      },
      {
        "libelle": "CE PC",
        "commande": "explorer.exe",
        "arguments": "shell:MyComputerFolder",
        "icone": "ce-pc.ico"
      },
      {
        "libelle": "RESEAU",
        "commande": "explorer.exe",
        "arguments": "shell:NetworkPlacesFolder",
        "icone": "reseau.ico"
      }
    ]
  },
  "icons": {
    "directory": "../assets/icons",
    "cePc": "ce-pc.ico",
    "reseau": "reseau.ico",
    "utilisateur": "utilisateur.ico",
    "panneauConfiguration": "panneau-configuration.ico",
    "corbeilleVide": "corbeille-vide.ico",
    "corbeillePleine": "corbeille-pleine.ico",
    "bureau": "bureau.ico",
    "documents": "documents.ico",
    "telechargements": "telechargements.ico",
    "images": "images.ico",
    "musique": "musique.ico",
    "videos": "videos.ico",
    "dossier": "dossier.ico",
    "lecteur": "lecteur.ico",
    "raccourciFleche": "raccourci-fleche.ico"
  }
}
